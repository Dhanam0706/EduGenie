# Copy this file to `.env` and fill in the values. NEVER commit the real .env file.

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Primary model. If it is retired/unavailable the app automatically tries the fallback models in config.py.
# Current model list: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash

# Optional
# GEMINI_TIMEOUT_SECONDS=25
# GEMINI_TOTAL_BUDGET_SECONDS=60
